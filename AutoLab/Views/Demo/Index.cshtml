@{
    ViewData["Title"] = "Laborator AJAX";
}

<h1>Laborator AJAX</h1>
<p class="text-muted small">Pagina generată la @DateTime.Now.ToString("HH:mm:ss"). Dacă ora nu se schimbă, pagina nu s-a reîncărcat.</p>

<div class="card mb-3">
    <div class="card-header fw-bold">1. Prima cerere asincronă</div>
    <div class="card-body">
        <button type="button" id="btnSalut" class="btn btn-primary">Cere salutul</button>
        <span id="rezultat1" class="ms-3"></span>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">2. Ce răspunde serverul</div>
    <div class="card-body">
        <button type="button" class="btn btn-outline-success test" data-adresa="/Demo/Salut">200 — totul e bine</button>
        <button type="button" class="btn btn-outline-warning test" data-adresa="/Automobile/Stare/999">404 — nu există</button>
        <button type="button" class="btn btn-outline-danger test" data-adresa="/Demo/Eroare">500 — eroare pe server</button>
        <button type="button" class="btn btn-outline-secondary test" data-adresa="/Demo/Lent">răspuns lent (2 s)</button>
        <span id="seIncarca2" class="ms-2 text-muted" hidden>Se încarcă…</span>
        <ol id="jurnal" class="mt-3 mb-0 font-monospace small"></ol>
        <p class="small text-muted mt-2 mb-0">Ca să vezi și cazul „serverul nu răspunde”: oprește aplicația (Shift+F5), lasă pagina deschisă și apasă orice buton.</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-bold">3. Același tabel, cerut cu jQuery</div>
    <div class="card-body">
        <button type="button" id="btnAjax" class="btn btn-outline-primary">SUV-urile cu $.ajax</button>
        <button type="button" id="btnLoad" class="btn btn-outline-primary">Hatchback-urile cu .load()</button>
        <div id="rezultat3" class="mt-3"></div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Prima cerere: fetch trimite cererea, iar funcțiile din .then
        //    se execută mai târziu, când sosește răspunsul.
        document.getElementById("btnSalut").addEventListener("click", function () {
            fetch("/Demo/Salut")
                .then(function (raspuns) {
                    return raspuns.text();
                })
                .then(function (text) {
                    document.getElementById("rezultat1").textContent = text;
                });
        });

        // 2. Codul de stare și cazul în care serverul nu răspunde.
        const jurnal = document.getElementById("jurnal");
        const seIncarca2 = document.getElementById("seIncarca2");

        function scrieInJurnal(text) {
            const rand = document.createElement("li");
            rand.textContent = text;
            jurnal.appendChild(rand);
        }

        function testeaza(adresa) {
            seIncarca2.hidden = false;
            fetch(adresa)
                .then(function (raspuns) {
                    seIncarca2.hidden = true;
                    scrieInJurnal("GET " + adresa + " → " + raspuns.status + ", raspuns.ok = " + raspuns.ok);
                })
                .catch(function () {
                    seIncarca2.hidden = true;
                    scrieInJurnal("GET " + adresa + " → serverul nu răspunde (.catch)");
                });
        }

        const butoane = document.querySelectorAll(".test");
        for (let i = 0; i < butoane.length; i++) {
            butoane[i].addEventListener("click", function () {
                testeaza(this.dataset.adresa);
            });
        }

        // 3. jQuery: aceeași cerere GET, cu $.ajax și cu .load().
        $("#btnAjax").click(function () {
            $.ajax({
                url: "/Automobile/Lista",
                data: { caroserie: "SUV" },
                success: function (html) {
                    $("#rezultat3").html(html);
                },
                error: function (xhr) {
                    $("#rezultat3").text("Eroare " + xhr.status + ". Acțiunea Lista există în controler?");
                }
            });
        });

        $("#btnLoad").click(function () {
            $("#rezultat3").load("/Automobile/Lista?caroserie=Hatchback");
        });
    </script>
}
