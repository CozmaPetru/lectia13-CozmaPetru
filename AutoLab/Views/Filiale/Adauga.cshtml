@model Filiala
@{
    ViewData["Title"] = "Filială nouă";
}

<h1>Filială nouă</h1>

<form asp-action="Adauga" method="post" class="col-md-4">
    <div class="mb-3">
        <label asp-for="Denumire" class="form-label"></label>
        <input asp-for="Denumire" class="form-control" />
        <span asp-validation-for="Denumire" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Salvează</button>
    <a asp-action="Index" class="btn btn-link">Renunță</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
