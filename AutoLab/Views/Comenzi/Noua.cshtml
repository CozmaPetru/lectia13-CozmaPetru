@model Comanda
@{
    ViewData["Title"] = "Comandă nouă";
}

<h1>Comandă nouă</h1>

<form asp-action="Noua" method="post">
    <div class="row mb-3">
        <div class="col-sm-3">
            <label asp-for="AutomobilId" class="form-label"></label>
            <input asp-for="AutomobilId" class="form-control" />
        </div>
        <div class="col-sm-3">
            <label asp-for="Avans" class="form-label"></label>
            <input asp-for="Avans" class="form-control" />
            <span asp-validation-for="Avans" class="text-danger"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <fieldset class="border rounded p-3 mb-3">
                <legend class="h5">Cumpărătorul</legend>
                <label asp-for="Cumparator.Nume" class="form-label"></label>
                <input asp-for="Cumparator.Nume" class="form-control mb-1" />
                <span asp-validation-for="Cumparator.Nume" class="text-danger"></span>
                <label asp-for="Cumparator.Telefon" class="form-label mt-1"></label>
                <input asp-for="Cumparator.Telefon" class="form-control mb-2" />
                <label asp-for="Cumparator.Adresa.Oras" class="form-label"></label>
                <input asp-for="Cumparator.Adresa.Oras" class="form-control mb-2" />
                <label asp-for="Cumparator.Adresa.Strada" class="form-label"></label>
                <input asp-for="Cumparator.Adresa.Strada" class="form-control" />
            </fieldset>
        </div>
        <div class="col-md-6">
            <fieldset class="border rounded p-3 mb-3">
                <legend class="h5">Garantul</legend>
                <label asp-for="Garant.Nume" class="form-label"></label>
                <input asp-for="Garant.Nume" class="form-control mb-1" />
                <span asp-validation-for="Garant.Nume" class="text-danger"></span>
                <label asp-for="Garant.Telefon" class="form-label mt-1"></label>
                <input asp-for="Garant.Telefon" class="form-control mb-2" />
                <label asp-for="Garant.Adresa.Oras" class="form-label"></label>
                <input asp-for="Garant.Adresa.Oras" class="form-control mb-2" />
                <label asp-for="Garant.Adresa.Strada" class="form-label"></label>
                <input asp-for="Garant.Adresa.Strada" class="form-control" />
            </fieldset>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Trimite comanda</button>
    <button type="submit" asp-action="DoarGarant" class="btn btn-outline-secondary">Verifică doar garantul</button>
</form>

@if (Context.Request.Method == "POST")
{
    <partial name="_Sonda" />
}
