@model List<PretNou>
@{
    ViewData["Title"] = "Prețuri";
}

<h1>Prețurile automobilelor</h1>

<form asp-action="Preturi" method="post">
    <table class="table table-sm table-striped w-auto">
        <thead><tr><th>Automobilul</th><th>Prețul, lei</th></tr></thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>
                        @Model[i].Denumire
                        <input type="hidden" asp-for="@Model[i].Id" />
                        <input type="hidden" asp-for="@Model[i].Denumire" />
                    </td>
                    <td>
                        <input asp-for="@Model[i].Pret" class="form-control form-control-sm" />
                        <span asp-validation-for="@Model[i].Pret" class="text-danger small"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit" class="btn btn-primary">Salvează prețurile</button>
</form>

@if (Context.Request.Method == "POST")
{
    <partial name="_Sonda" />
}
