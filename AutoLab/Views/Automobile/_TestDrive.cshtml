@model Programare

<form id="formTestDrive" asp-controller="Automobile" asp-action="TestDrive" method="post">
    <input type="hidden" asp-for="AutomobilId" />
    <div class="mb-2">
        <label asp-for="Nume" class="form-label"></label>
        <input asp-for="Nume" class="form-control" />
        <span asp-validation-for="Nume" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Telefon" class="form-label"></label>
        <input asp-for="Telefon" class="form-control" />
        <span asp-validation-for="Telefon" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Ziua" class="form-label"></label>
        <input asp-for="Ziua" class="form-control" />
        <span asp-validation-for="Ziua" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Programează</button>
</form>
