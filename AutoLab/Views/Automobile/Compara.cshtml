@model List<Automobil>
@{
    ViewData["Title"] = "Comparare";
}

<h1>Automobile comparate: <span id="numar">@Model.Count</span></h1>

<table class="table table-sm table-bordered w-auto">
    <thead>
        <tr>
            <th></th>
            @foreach (Automobil automobil in Model)
            {
                <th>@automobil.Marca @automobil.Modelul</th>
            }
        </tr>
    </thead>
    <tbody>
        <tr>
            <th>Anul</th>
            @foreach (Automobil automobil in Model)
            {
                <td>@automobil.AnFabricatie</td>
            }
        </tr>
        <tr>
            <th>Prețul</th>
            @foreach (Automobil automobil in Model)
            {
                <td>@automobil.Pret.ToString("N2")</td>
            }
        </tr>
        <tr>
            <th>Combustibilul</th>
            @foreach (Automobil automobil in Model)
            {
                <td>@automobil.Combustibil</td>
            }
        </tr>
    </tbody>
</table>

<partial name="_Sonda" />
<a asp-action="Alege" class="btn btn-link">Altă alegere</a>
